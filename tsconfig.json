{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "playwright.config.ts",
    "e2e/**/*.ts",
    "tools/budget/**/*.ts",
    "tools/api-types/**/*.ts",
    "tools/install-check/**/*.ts"
  ]
}
