{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "ombra",
  "homepage": "https://github.com/marciobarrios/ombra",
  "items": [
    {
      "name": "ombra",
      "type": "registry:component",
      "title": "Ombra",
      "description": "Composable lightbox parts (root, trigger, dialog shell, slides, media, zoom, controls) with two editable recipes: a grid gallery and a single-cover album.",
      "docs": "The trigger image needs a laid-out size and object-fit so the morph has a box. Do not clip the trigger or put it inside a transformed ancestor. flip is the default engine, and reduced motion forces fade. Dependencies are React, @base-ui/react, and cn. Do not add an animation library.",
      "dependencies": ["@base-ui/react", "cn"],
      "registryDependencies": ["utils"],
      "css": {
        "@property --ombra-pull-live": {
          "syntax": "\"<number>\"",
          "inherits": "true",
          "initial-value": "0"
        },
        ":root": {
          "--ombra-pull-amount": "max(var(--ombra-pull-live), -1 * var(--ombra-pull-live))"
        },
        "[data-slot=\"ombra-sheet\"]": {
          "transform": "translate3d(0, calc(var(--ombra-pull-live) * 22dvh), 0) scale(calc(1 - var(--ombra-pull-amount) * 0.07))",
          "transform-origin": "center center",
          "border-radius": "calc(var(--ombra-pull-amount) * 24px)"
        },
        "[data-slot=\"ombra-backdrop\"]": {
          "opacity": "calc(1 - var(--ombra-pull-amount) * 0.7)"
        },
        "[data-slot=\"ombra-chrome\"]": {
          "transition": "opacity 200ms"
        },
        "[data-chrome=\"hidden\"] [data-slot=\"ombra-chrome\"]": {
          "opacity": "0"
        },
        "[data-chrome=\"hidden\"] [data-slot=\"ombra-chrome\"], [data-chrome=\"hidden\"] [data-slot=\"ombra-chrome\"] *": {
          "pointer-events": "none"
        },
        "[data-chrome=\"hidden\"] [data-slot=\"ombra-chrome\"]:focus-within": {
          "opacity": "1",
          "pointer-events": "auto"
        },
        "[data-chrome=\"hidden\"] [data-slot=\"ombra-chrome\"]:focus-within *": {
          "pointer-events": "auto"
        },
        "@media (prefers-reduced-motion: reduce)": {
          "[data-slot=\"ombra-sheet\"]": {
            "transform": "none",
            "border-radius": "0"
          },
          "[data-slot=\"ombra-chrome\"]": {
            "transition": "none"
          }
        },
        "@media (forced-colors: active)": {
          "[data-slot=\"ombra-close\"], [data-slot=\"ombra-previous\"], [data-slot=\"ombra-next\"], [data-slot=\"ombra-zoom-in\"], [data-slot=\"ombra-zoom-out\"]": {
            "border": "1px solid ButtonText"
          },
          "[data-slot=\"ombra-close\"]:focus-visible, [data-slot=\"ombra-previous\"]:focus-visible, [data-slot=\"ombra-next\"]:focus-visible, [data-slot=\"ombra-zoom-in\"]:focus-visible, [data-slot=\"ombra-zoom-out\"]:focus-visible, [data-slot=\"ombra-thumbnail\"]:focus-visible, [data-slot=\"ombra-track\"]:focus-visible, [data-slot=\"ombra-trigger\"]:focus-visible": {
            "outline": "2px solid Highlight"
          },
          "[data-slot=\"ombra-previous\"]:disabled, [data-slot=\"ombra-next\"]:disabled, [data-slot=\"ombra-zoom-in\"]:disabled, [data-slot=\"ombra-zoom-out\"]:disabled": {
            "opacity": "1",
            "color": "GrayText"
          },
          "[data-slot=\"ombra-thumbnail\"]": {
            "opacity": "1",
            "border-color": "ButtonText"
          },
          "[data-slot=\"ombra-thumbnail\"][data-active=\"true\"]": {
            "border-color": "Highlight"
          }
        }
      },
