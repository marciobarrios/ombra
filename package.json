{
  "name": "ombra",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter docs dev",
    "build": "pnpm --filter docs build",
    "start": "pnpm --filter docs start",
    "lint": "oxlint .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "pnpm --filter docs typecheck && tsc -p tsconfig.json --noEmit",
    "test:e2e": "playwright test",
    "registry:build": "shadcn build registry.json -o apps/docs/public/r"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.91.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "shadcn": "4.23.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.4"
}
